{
  "name": "css-mediaquery2",
  "version": "1.1.0",
  "description": "Parses and determines if a given CSS Media Query matches a set of values.",
  "bugs": {
    "url": "https://github.com/efoken/css-mediaquery2/issues"
  },
  "license": "ISC",
  "author": "Eike Foken <eikefoken@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efoken/css-mediaquery2.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src.cjs",
  "module": "./dist/src.mjs",
  "types": "./dist/src.d.cts",
  "exports": {
    ".": {
      "import": "./dist/src.mjs",
      "require": "./dist/src.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown src --dts",
    "lint": "oxlint src",
    "format": "oxfmt src test",
    "test": "vitest run"
  },
  "devDependencies": {
    "csstype": "^3.2.3",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "tsdown": {
    "format": [
      "cjs",
      "esm"
    ],
    "minify": true,
    "outputOptions": {
      "exports": "named"
    }
  }
}
